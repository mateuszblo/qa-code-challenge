# Copy to .env and fill in real values — all three are REQUIRED, the suite will not start
# without them (see tests/config/env.ts). Deliberately no in-source fallback: a fallback would
# mean the credential is committed to the repo whether or not .env is ever configured.
#
# A valid dummyjson account works (https://dummyjson.com/docs/auth) — this app has no accounts
# of its own, it proxies straight through to dummyjson.
TEST_USERNAME='emilys'
TEST_PASSWORD='emilyspass'

# Used only by the "invalid credentials" known-bug test — any value that is NOT TEST_PASSWORD.
# Unrelated to TEST_PASSWORD; there is no need to keep the two in sync.
TEST_WRONG_PASSWORD='WronG_Password!'
